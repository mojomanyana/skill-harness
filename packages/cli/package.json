{
    "name": "@skill-harness/cli",
    "version": "0.12.0",
    "description": "skill-harness CLI — run, grade, review, and lint agent-skill scenarios on the pi harness",
    "type": "module",
    "license": "MIT",
    "main": "./dist/cli.js",
    "bin": {
        "skill-harness": "dist/cli.js"
    },
    "exports": {
        ".": "./dist/cli.js",
        "./serve": "./dist/serve.js"
    },
    "keywords": [
        "agent-skills",
        "skill",
        "llm",
        "testing",
        "eval",
        "grading",
        "pi",
        "ci",
        "harness"
    ],
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "assets",
        "LICENSE",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mojomanyana/skill-harness.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "prepack": "node ../../scripts/release-pack.mjs --guard"
    },
    "dependencies": {
        "@skill-harness/core": "0.12.0",
        "@skill-harness/adapters": "0.12.0"
    }
}
