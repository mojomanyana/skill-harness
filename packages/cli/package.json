{
  "name": "@skill-harness/cli",
  "version": "1.0.2",
  "description": "skill-harness CLI \u2014 run, grade, review, and lint agent-skill scenarios on the pi harness",
  "type": "module",
  "license": "MIT",
  "main": "./dist/cli.js",
  "bin": {
    "skill-harness": "1.0.2"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./serve": "./dist/serve.js"
  },
  "keywords": [
    "agent-skills",
    "skill",
    "llm",
    "testing",
    "eval",
    "grading",
    "pi",
    "ci",
    "harness"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojomanyana/skill-harness.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "node ../../scripts/release-pack.mjs --guard"
  },
  "dependencies": {
    "@skill-harness/core": "1.0.2",
    "@skill-harness/adapters": "1.0.2"
  }
}
