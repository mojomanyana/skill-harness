{
  "name": "skill-harness",
  "version": "0.13.0",
  "description": "Test/optimize loop for agent skills — run spec'd scenarios on pi, LLM-judge, score, review, re-run",
  "type": "module",
  "keywords": [
    "agent-skills",
    "skill",
    "llm",
    "testing",
    "eval",
    "grading",
    "pi",
    "ci",
    "harness"
  ],
  "bin": {
    "skill-harness": "bin.js"
  },
  "pi": {
    "extensions": ["./dist/index.js"]
  },
  "files": [
    "bin.js",
    "dist/index.js",
    "dist/prompt-capture-extension.js",
    "assets/report.template.html",
    "assets/report.grade.js",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@skill-harness/cli": "0.13.0",
    "typebox": "^1.1.38"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojomanyana/skill-harness.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "node ../../scripts/release-pack.mjs --guard"
  }
}
