{
    "name": "@skill-harness/adapters",
    "version": "0.22.0",
    "description": "skill-harness Pi runner and judge adapter (internal API)",
    "type": "module",
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./prices/*.json": "./prices/*.json"
    },
    "keywords": [
        "agent-skills",
        "skill",
        "llm",
        "testing",
        "eval",
        "grading",
        "pi",
        "ci",
        "harness"
    ],
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "prices/*.json",
        "LICENSE",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mojomanyana/skill-harness.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "prepack": "node ../../scripts/release-pack.mjs --guard"
    },
    "dependencies": {
        "@skill-harness/core": "0.22.0"
    }
}
