{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-harness.dev/schemas/results-v2.schema.json",
  "title": "skill-harness results v2",
  "type": "object",
  "required": [
    "schema",
    "skill",
    "harness",
    "model",
    "judge",
    "timestamp",
    "label",
    "mode",
    "effective_grade",
    "scenarios"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "harness_version": {
      "type": "string"
    },
    "harness_cli_version": {
      "type": "string"
    },
    "delivery_canary": {
      "enum": [
        "pass",
        "skipped"
      ]
    },
    "skill": {
      "type": "string"
    },
    "harness": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "judge": {
      "type": "object",
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    },
    "timestamp": {
      "type": "string"
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "enum": [
        "red",
        "green",
        "force"
      ]
    },
    "partial": {
      "type": "boolean"
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "source_hash_roots": {
      "type": "object",
      "additionalProperties": {
        "enum": ["skills", "specs"]
      }
    },
    "effective_grade": {
      "$ref": "#/$defs/grade"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "JUDGE-AMBIGUOUS",
        "UNGRADED"
      ]
    },
    "grade": {
      "type": "object",
      "required": [
        "passed",
        "total",
        "pct",
        "letter",
        "ship",
        "note"
      ],
      "properties": {
        "passed": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "pct": {
          "type": "number"
        },
        "letter": {
          "type": "string"
        },
        "ship": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetition", "inputTokens", "outputTokens", "cacheReadTokens", "costUsd", "priceAsOf"],
      "properties": {
        "repetition": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": ["integer", "null"], "minimum": 1 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 1 },
        "cacheReadTokens": { "type": ["integer", "null"], "minimum": 1 },
        "costUsd": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "priceAsOf": { "type": ["string", "null"] }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "wall_time_ms",
        "judge_calls",
        "judge_rejudge_calls",
        "subject_metrics_reps",
        "total_reps"
      ],
      "properties": {
        "wall_time_ms": {
          "type": "number",
          "minimum": 0
        },
        "judge_calls": {
          "type": "integer",
          "minimum": 0
        },
        "judge_rejudge_calls": {
          "type": "integer",
          "minimum": 0
        },
        "subject_metrics_reps": {
          "type": "integer",
          "minimum": 0
        },
        "total_reps": {
          "type": "integer",
          "minimum": 1
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "subject_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "cost_source": {
          "enum": [
            "provider-reported",
            "subscription",
            "price-table",
            "unreported"
          ]
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "delegated_children": {
          "type": "integer",
          "minimum": 0
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "judge",
        "verdict",
        "reason",
        "suspect"
      ],
      "properties": {
        "judgeFormat": { "enum": ["json", "prose"] },
        "judgeRetries": { "type": "integer", "const": 1 },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model"
          ],
          "properties": {
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          }
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "reason": {
          "type": "string"
        },
        "suspect": {
          "type": "boolean"
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "judge_verdict",
        "judge_reason",
        "suspect",
        "override",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "judge_verdict": {
          "$ref": "#/$defs/verdict"
        },
        "judge_reason": {
          "type": "string"
        },
        "suspect": {
          "type": "boolean"
        },
        "override": {
          "oneOf": [
            {
              "const": null
            },
            {
              "enum": [
                "PASS",
                "FAIL"
              ]
            }
          ]
        },
        "note": {
          "type": "string"
        },
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "passes": {
          "type": "integer",
          "minimum": 0
        },
        "clean": {
          "type": "integer",
          "minimum": 0
        },
        "flakiness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ungraded_reps": {
          "type": "integer",
          "minimum": 1
        },
        "pass_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "usage": {
          "type": "array",
          "items": { "$ref": "#/$defs/usage" }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "assertions"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "ERROR"
              ]
            },
            "trace_version": {
              "type": "integer"
            },
            "trace_sha256": {
              "type": "string"
            },
            "output_sha256": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "rep_trace_sha256": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            },
            "rep_output_sha256": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            },
            "assertions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "status",
                  "detail"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "ERROR"
                    ]
                  },
                  "detail": {
                    "type": "string"
                  }
                }
              }
            },
            "trajectory_version": {
              "type": "string"
            },
            "events_sha256": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "rep_events_sha256": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        },
        "adjudication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "trigger",
            "judgments"
          ],
          "properties": {
            "state": {
              "enum": [
                "confirmed",
                "tie_broken",
                "unresolved"
              ]
            },
            "trigger": {
              "enum": [
                "ambiguous",
                "contradictory",
                "non_unanimous",
                "ship_deciding"
              ]
            },
            "verdict": {
              "enum": [
                "PASS",
                "FAIL"
              ]
            },
            "judgments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/judgment"
              }
            }
          }
        },
        "judge_history": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/judgment"
          }
        }
      }
    }
  }
}
