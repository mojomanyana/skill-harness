{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-harness.dev/schemas/specification-v1.schema.json",
  "title": "skill-harness specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "judge_persona",
    "ship_bar",
    "scenarios"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "judge_persona": {
      "type": "string",
      "minLength": 1
    },
    "ship_bar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "min_pass"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "min_pass": {
          "type": "integer",
          "minimum": 1
        },
        "no_critical_fail": {
          "type": "boolean"
        }
      }
    },
    "critical": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "turns",
        "checklist"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "critical": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "inline",
            "seeded"
          ]
        },
        "fixture": {
          "type": "string"
        },
        "turns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "checklist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "pass_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "system_prompt_file": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workspace": {},
            "remote": {
              "type": "boolean"
            },
            "extensions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "assert": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vitest": {
              "type": "boolean"
            },
            "diff_contains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "diff_excludes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "post_test": {
              "type": "string"
            },
            "trace": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
