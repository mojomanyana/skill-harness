{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-harness.dev/schemas/specification-v1.schema.json",
  "title": "skill-harness specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "judge_persona",
    "ship_bar",
    "scenarios"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "judge_persona": {
      "type": "string",
      "minLength": 1
    },
    "ship_bar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "min_pass"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "min_pass": {
          "type": "integer",
          "minimum": 1
        },
        "no_critical_fail": {
          "type": "boolean"
        }
      }
    },
    "critical": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "turns",
        "checklist"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "critical": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "inline",
            "seeded"
          ]
        },
        "fixture": {
          "type": "string"
        },
        "turns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "checklist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "judge_context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "\\S",
          "description": "Explicit author-supplied reference text for the judge only. The runtime also enforces at most 65536 UTF-8 bytes. Not a file path; no files are loaded. Changes stale the rubric only."
        },
        "criterion_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["task-correctness", "method-completeness", "mixed"] },
          "description": "Optional author-declared report metadata in checklist order. Runtime requires the same length as checklist. Omission is unclassified; mixed items are not split. Excluded from model prompts and all grading hashes."
        },
        "judge_evidence": {
          "enum": ["response", "code"],
          "description": "Evidence emphasis, independent of fixture workspace. Response tasks never receive code-diff priority guidance."
        },
        "judge_references": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Explicit relative POSIX files below the specification directory, judge-only, collectively at most 65536 UTF-8 bytes. Runtime rejects traversal, escaping symlinks and binary data."
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "pass_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "system_prompt_file": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workspace": {},
            "remote": {
              "type": "boolean"
            },
            "extensions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tools": {
              "type": "array", "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_:/.-]*$" },
              "description": "Explicit Pi tool filter. Empty list disables all tools. Not an OS sandbox."
            }
          }
        },
        "assert": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vitest": {
              "type": "boolean"
            },
            "diff_contains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "diff_excludes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "output_matches": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "output_excludes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "post_test": {
              "type": "string"
            },
            "trace": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
